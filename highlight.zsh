# fast-syntax-highlighting 在插件加载后读取这组颜色。
typeset -A _flat_white_styles=(
  default 'none'
  unknown-token "fg=$color1,bold"
  reserved-word "fg=$color3"
  subcommand "fg=$color4"
  alias "fg=$color4"
  suffix-alias "fg=$color4"
  global-alias "fg=$color5"
  builtin "fg=$color4"
  function "fg=$color4"
  command "fg=$color4"
  precommand "fg=$color3"
  hashed-command "fg=$color4"
  commandseparator "fg=$color8"
  redirection "fg=$color6"
  comment "fg=$color8,italic"
  path "fg=$foreground,underline"
  path-to-dir "fg=$color4,underline"
  pathseparator "fg=$color8"
  globbing "fg=$color5"
  globbing-ext "fg=$color13"
  single-hyphen-option "fg=$color6"
  double-hyphen-option "fg=$color6"
  single-quoted-argument "fg=$color2"
  double-quoted-argument "fg=$color2"
  dollar-quoted-argument "fg=$color2"
  back-quoted-argument "fg=$color6"
  back-dollar-quoted-argument "fg=$color6"
  back-or-dollar-double-quoted-argument "fg=$color6"
  variable "fg=$foreground"
  assign "fg=$foreground"
  assign-array-bracket "fg=$color6"
  history-expansion "fg=$color5"
  mathvar "fg=$color4"
  mathnum "fg=$color5"
  matherr "fg=$color1"
  paired-bracket "fg=$foreground,bg=$selection_bg"
  bracket-level-1 "fg=$color2"
  bracket-level-2 "fg=$color3"
  bracket-level-3 "fg=$color6"
  here-string-tri "fg=$color3"
  here-string-text "fg=$color2"
  here-string-var "fg=$color6"
  exec-descriptor "fg=$color3"
  correct-subtle "fg=$color4"
  incorrect-subtle "fg=$color1"
  subtle-separator "fg=$color2"
  subtle-bg "bg=$color0"
  forvar "fg=$foreground"
  fornum "fg=$color5"
  foroper "fg=$color3"
  forsep "fg=$color3"
  case-input "fg=$color2"
  case-parentheses "fg=$color3"
  case-condition "fg=$color4"
  single-sq-bracket "fg=$color6"
  double-sq-bracket "fg=$color6"
  double-paren "fg=$color3"
)

for _flat_white_name _flat_white_style in "${(@kv)_flat_white_styles}"; do
  FAST_HIGHLIGHT_STYLES[default$_flat_white_name]=$_flat_white_style
  FAST_HIGHLIGHT_STYLES[free$_flat_white_name]=$_flat_white_style
done
unset _flat_white_styles _flat_white_name _flat_white_style
